generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model categories {
  id                    Int                     @id @default(autoincrement())
  name                  String                  @db.VarChar(100)
  category_relationship category_relationship[]
}

model wireframes {
  id                    Int                     @id @default(autoincrement())
  title                 String                  @db.VarChar(255)
  cover                 String?
  category_relationship category_relationship[]
  codesnippets          codesnippets[]
  editable_relationship editable_relationship[]
  editablecodes         editablecodes[]
}

model editables {
  id                    Int                     @id @default(autoincrement())
  name                  String                  @db.VarChar(100)
  dropdown_options      String[]
  switch_options        String[]
  number_range          Int[]
  editable_relationship editable_relationship[]
  editablecodes         editablecodes[]
}

model category_relationship {
  id           Int         @id @default(autoincrement())
  wireframe_id Int?
  category_id  Int?
  categories   categories? @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wireframes   wireframes? @relation(fields: [wireframe_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model codesnippets {
  id           Int         @id @default(autoincrement())
  name         String      @db.VarChar(100)
  type         String?
  wireframe_id Int?
  codesnippet  String?
  wireframes   wireframes? @relation(fields: [wireframe_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model editable_relationship {
  id           Int         @id @default(autoincrement())
  wireframe_id Int?
  editable_id  Int?
  editables    editables?  @relation(fields: [editable_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wireframes   wireframes? @relation(fields: [wireframe_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model editablecodes {
  id             Int         @id @default(autoincrement())
  codesnippet    String?
  type           String?
  editable_type  String?
  editable_value String?
  editable_id    Int?
  wireframe_id   Int?
  editables      editables?  @relation(fields: [editable_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wireframes     wireframes? @relation(fields: [wireframe_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
